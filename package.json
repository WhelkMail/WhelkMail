{
  "name": "whelkmail",
  "description": "WhelkMail — Gmail-style webmail client for IMAP/SMTP mailboxes on Cloudflare",
  "author": "mlzog",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --proxy 5173 --port 8788",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "db:local": "wrangler d1 execute mail-client --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute mail-client --remote --file=./db/schema.sql",
    "db:migrate:local": "node scripts/migrate.mjs local",
    "db:migrate:remote": "node scripts/migrate.mjs remote",
    "db:migrate:local:12": "wrangler d1 execute mail-client --local --file=./db/migrations/012_security.sql",
    "db:migrate:remote:12": "wrangler d1 execute mail-client --remote --file=./db/migrations/012_security.sql",
    "db:migrate:local:19": "wrangler d1 execute mail-client --local --file=./db/migrations/019_search_text.sql",
    "db:migrate:remote:19": "wrangler d1 execute mail-client --remote --file=./db/migrations/019_search_text.sql",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cron:deploy": "node scripts/ensure-worker-config.mjs && wrangler deploy -c worker/wrangler.toml",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "publish:public": "sh scripts/publish-public.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true
  }
}
